# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
#
#   cp .env.example .env
#
# Then load it before running the pipeline, e.g.:
#   export $(grep -v '^#' .env | xargs)      # quick-and-dirty
# or install python-dotenv and load it at the top of run_pipeline.py.

