{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python@4.6.0",
      "config": {
        "requirementsPath": "requirements.txt"
      }
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
